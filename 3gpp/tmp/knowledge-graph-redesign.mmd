    end

    %% ===== 跨层标签体系 =====
    subgraph TAGS["🏷️ 跨层标签体系 (frontmatter)"]
        direction LR
        TAG1["type: spec | channel<br/>algorithm | definition"]:::meta
        TAG2["layer: L0 | L1 | L2 | L3"]:::meta
        TAG3["domain: math | codec<br/>rtl | verification"]:::meta
        TAG4["maturity: draft<br/>reviewed | stable"]:::meta
        TAG5["source_spec: TS xx.xxx"]:::meta
    end

    %% ===== 核心关系 =====
    EXTRACT -->|"📥 原料输入"| L1
    EXTRACT -->|"📥 原料输入"| L2

    M3 -.->|"实现验证"| PY2
    A1 -.->|"实现验证"| PY3
    A3 -.->|"实现验证"| PY4
    A2 -.->|"实现验证"| PY5

    CORE -->|"审计扫描"| QA
    QA -.->|"修复反馈"| CORE

    TAGS -.->|"标注"| CORE
    TAGS -.->|"标注"| SOURCE

    G1 -.->|"渲染"| CORE
    G2 -.->|"查询"| CORE
    G3 -.->|"导航"| CORE

    SIM -.->|"验证结果反馈"| L3
    TEST -->|"bit-exact验证"| E1

