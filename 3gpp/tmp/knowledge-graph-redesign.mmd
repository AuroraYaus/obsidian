    subgraph CORE["🧠 知识核心层 — docs/ (100篇讲义)"]
        direction TB

        subgraph L0["L0 术语表"]
            L0a["缩写全称对照"]:::defn
            L0b["协议术语定义"]:::defn
        end

        subgraph L1["L1 数学基础 (33篇)"]
            direction LR
            M1["M1 GF(2)算术"]:::math
            M2["M2 软解调/信道"]:::math
            M3["M3 CRC/分段"]:::math
            M4["M4 译码工程概念"]:::math
            M5["M5 RTL前置知识"]:::math
        end

        subgraph L2["L2 协议与算法"]
            direction LR
            A1["LDPC译码算法"]:::algo
            A2["Turbo译码算法"]:::algo
            A3["Polar译码算法"]:::algo
            A4["速率匹配/交织"]:::algo
            A5["HARQ与重传"]:::algo
        end

        subgraph L3["L3 工程实现"]
            direction LR
            E1["定点化模型"]:::engine
            E2["RTL微架构"]:::engine
            E3["验证策略"]:::engine
            E4["DC综合流程"]:::engine
            E5["时序收敛"]:::engine
        end

        L0 --> L1 --> L2 --> L3
    end

    %% ===== 仿真验证层 =====
    subgraph SIM["🔬 仿真验证层 — sim/"]
        direction LR
        PY1["gf2.py<br/>GF(2)运算库"]:::code
        PY2["crc.py<br/>CRC计算"]:::code
        PY3["ldpc.py<br/>LDPC编解码"]:::code
        PY4["polar.py<br/>Polar编解码"]:::code
        PY5["turbo.py<br/>Turbo编解码"]:::code
        TEST["test_*.py<br/>单元测试"]:::code
        PY1 & PY2 & PY3 & PY4 & PY5 --> TEST
    end

    %% ===== 质量保障层 =====
    subgraph QA["🛡️ 质量保障层 — tools/"]
        direction LR
        T1["audit_latex_render.py<br/>公式可渲染检查"]:::tool
        T2["audit_lesson_terms.py<br/>术语合规检查"]:::tool
        T3["audit_figure_*.py<br/>图片质量审计"]:::tool
        T4["normalize_*.py<br/>缩写规范化"]:::tool
        T5["audit_lesson_depth.py<br/>层级深度审计"]:::tool
        T6["extract_3gpp_word.py<br/>协议文档抽取"]:::tool
    end

    %% ===== 图谱呈现层 =====
    subgraph GRAPH["🗺️ 图谱呈现层 — .obsidian/"]
