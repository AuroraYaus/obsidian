flowchart TD
    %% ===== 协议源头层 =====
    subgraph SOURCE["📜 协议源头层 — 3GPP_Rel19/"]
        direction LR
        S1["TS 36.211<br/>LTE PHY"]:::spec
        S2["TS 36.212<br/>LTE MUX/CH"]:::spec
        S3["TS 36.213<br/>LTE Procedure"]:::spec
        S4["TS 38.211<br/>NR PHY"]:::spec
        S5["TS 38.212<br/>NR MUX/CH"]:::spec
        S6["TS 38.213<br/>NR Procedure"]:::spec
        S7["TS 38.214<br/>NR Data"]:::spec
        EXTRACT["📦 processed/<br/>content.md + tables + equations"]:::tool
        S1 & S2 & S3 & S4 & S5 & S6 & S7 --> EXTRACT
    end

